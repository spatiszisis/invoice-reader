# =============================================================================
# Invoice Reader — env config
#
# Everything runs on your Mac directly:
#   - LM Studio (desktop app, uses Metal GPU)
#   - Backend (uvicorn on host)
#   - Frontend (vite on host)
# =============================================================================

# LM Studio's OpenAI-compatible server. Default port is 1234. Verify
# this matches what LM Studio shows in Developer → Server.
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Identifier for the loaded model. Largely decorative — LM Studio uses
# whatever's currently loaded. You can leave this as "local-model".
#
# Recommended (in order, for invoice extraction quality+speed on Mac):
#   1. Llama 3.1 8B Instruct (Q4_K_M)  ~5GB — best balance, smart enough
#      to handle messy OCR text
#   2. Qwen 2.5 7B Instruct             ~5GB — strong on structured JSON
#   3. Llama 3.2 3B Instruct            ~2GB — fastest, but struggles
#      with messy OCR + complex schema (slower in practice on real photos)
EXTRACTION_MODEL=local-model

# Per-request timeout. CPU inference can take 30–90s; GPU is 3–10s.
LMSTUDIO_TIMEOUT_SECONDS=300

# Upload limits
MAX_UPLOAD_MB=10
MAX_BATCH=20

# CORS — frontend runs at :5173 by default
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LOG_LEVEL=INFO
